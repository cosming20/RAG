# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Qdrant
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_REST_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_chunks

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# LLM (via LiteLLM)
LLM_DEFAULT_MODEL=openai/gpt-4o
LLM_EMBEDDING_MODEL=openai/text-embedding-3-large
LLM_EMBEDDING_DIMENSIONS=3072
LLM_API_KEY=
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# Jina Reranker
JINA_API_KEY=
JINA_MODEL=jina-reranker-v2-base-multilingual

# Agent
AGENT_GRPC_PORT=50051
AGENT_HEARTBEAT_INTERVAL_SECONDS=5.0
AGENT_HEARTBEAT_TTL_SECONDS=30
AGENT_TASK_TIMEOUT_SECONDS=300
AGENT_MAX_TASK_RETRIES=3
AGENT_MAX_PIPELINE_DEPTH=10

# Observability (OpenTelemetry)
OTEL_SERVICE_NAME=rag-agent
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
OTEL_LOG_LEVEL=INFO
OTEL_LOG_FORMAT=json
OTEL_METRICS_PORT=9090
OTEL_ENABLE_TRACING=true
OTEL_ENABLE_METRICS=true
